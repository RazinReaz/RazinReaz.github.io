---
import Layout from "../layouts/Layout.astro";
import Slider from "../components/Slider.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AchievementCard from "../components/AchievementCard.astro";
import LinkCard from "../components/LinkCard.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import Timeline from "../components/Timeline.astro";
import { projects } from "../data/projects.js";
import { achievements } from "../data/achievements.js";
import { hobbies } from "../data/hobbies.js";
import { publications } from "../data/publications.js";
import { jobs, education, research } from "../data/experience.js";
---

<Layout>
  <div class="about" id="About">
    <h2 class="about__title">Hi! I am Razin 👋</h2>
    <h3 class="about__subtitle">These are some of my creations<br>Why not give them a click?</h3>

    <Slider />

    <br class="spacer"><br class="spacer">
    <p>
      I am currently a first year PhD student at <a href="https://www.umontreal.ca/en/" target="_blank">Université de Montréal</a> (UdeM), advised by <a href="https://www-labs.iro.umontreal.ca/~bmpix/" target="_blank">Dr. Mikhail Bessmeltsev</a>.
      I am interested in Physics-based simulation and Character Animation in computer graphics.
    </p>
    <p>
      In the past, I worked as a junior research assistant at <a href="https://universalmachine.io" target="_blank">Universal Machine Inc.</a> and as an adjunct lecturer at the
      <a href="https://cse.buet.ac.bd/" target="_blank">Department of Computer Science and Engineering</a>,
      <a href="https://www.buet.ac.bd/web/#/" target="_blank">BUET</a>.
    </p>
  </div>

  <div class="content" id="Publications">
    <h1>Publications</h1>
    <div class="publications">
      {publications.map((publication) => <PublicationEntry publication={publication} />)}
    </div>
  </div>

  <div class="content" id="Research">
    <h1>Research Experience</h1>
    <Timeline items={research} />
  </div>

  <div class="content" id="Projects">
    <h1>Projects</h1>
    <div class="cards">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  <div class="content" id="Resume">
    <h1>Job Experience</h1>
    <Timeline items={jobs} />
  </div>

  <div class="content" id="Education">
    <h1>Education</h1>
    <Timeline items={education} />
  </div>

  <div class="content" id="Achievements">
    <h1>Achievements</h1>
    <div class="cards">
      {achievements.map((achievement) => <AchievementCard achievement={achievement} />)}
    </div>
  </div>

  <div class="content" id="More">
    <h1>More about me</h1>
    <div class="link-card-container">
      {hobbies.map((hobby) => <LinkCard hobby={hobby} />)}
    </div>
  </div>
</Layout>

<style>
  .content {
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
    padding-top: var(--spacing-3xl);
    transform: translateY(4rem);
    opacity: 0;
    transition: transform var(--transition-normal), opacity var(--transition-normal);
  }

  .content--visible-up,
  .content--visible-down {
    opacity: 1;
    transform: translateY(0);
  }

  .content--hidden-up {
    opacity: 0;
    transform: translateY(-2rem);
  }

  .content--hidden-down {
    opacity: 0;
    transform: translateY(2rem);
  }

  .about {
    padding-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  .about__title {
    font-weight: var(--font-weight-normal);
    text-align: center;
    padding-top: var(--spacing-sm);
  }

  .about__subtitle {
    font-weight: 350;
    text-align: center;
  }

  .publications {
    display: grid;
    gap: var(--spacing-xl);
  }

  .link-card-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--spacing-lg);
    margin: 0 auto;
    max-width: 1000px;
  }

  @media (max-width: 767px) {
    .spacer {
      display: none;
    }

    .content {
      margin-top: var(--spacing-lg);
      margin-bottom: var(--spacing-xl);
      padding-top: var(--spacing-xl);
    }

    .content h1 {
      font-size: var(--font-size-2xl);
    }

    .about {
      padding-top: var(--spacing-lg);
      margin-bottom: var(--spacing-xl);
    }

    .about__title {
      font-size: var(--font-size-xl);
      padding-top: 0;
    }

    .about__subtitle {
      font-size: var(--font-size-sm);
      line-height: 1.4;
    }

    .about p {
      line-height: 1.5;
    }

    .link-card-container {
      gap: var(--spacing-md);
    }
  }

  @media (max-width: 575px) {
    .content h1 {
      font-size: var(--font-size-xl);
    }

    .about__title {
      font-size: var(--font-size-lg);
    }

    .about__subtitle {
      font-size: var(--font-size-xs);
    }
  }
</style>
