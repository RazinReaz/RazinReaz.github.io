---
const navItems = [
  { href: "#About", label: "About Me" },
  { href: "#Publications", label: "Publications" },
  { href: "#Research", label: "Research" },
  { href: "#Projects", label: "Projects" },
  { href: "#Resume", label: "Resume" },
  { href: "#Achievements", label: "Achievements" },
  { href: "#More", label: "More" },
];
---

<nav class="navbar">
  <button
    type="button"
    class="menu-icon"
    id="menu-toggle"
    aria-expanded="false"
    aria-controls="nav-list"
    aria-label="Toggle navigation menu"
  >
    <span class="menu-icon__line"></span>
    <span class="menu-icon__line"></span>
    <span class="menu-icon__line"></span>
  </button>
  <ul class="nav-list" id="nav-list">
    {navItems.map((item) => (
      <li class="nav-list__item">
        <a href={item.href} class="nav-list__link u-underline">{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const navList = document.getElementById("nav-list");

  if (menuToggle && navList) {
    const closeMenu = () => {
      navList.classList.remove("show");
      menuToggle.classList.remove("active");
      menuToggle.setAttribute("aria-expanded", "false");
    };

    const toggleMenu = () => {
      const isOpen = navList.classList.toggle("show");
      menuToggle.classList.toggle("active");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
    };

    menuToggle.addEventListener("click", toggleMenu);

    navList.querySelectorAll(".nav-list__link").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("click", (event) => {
      if (!navList.classList.contains("show")) return;
      if (navList.contains(event.target) || menuToggle.contains(event.target)) return;
      closeMenu();
    });
  }
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    height: var(--navbar-height);
    width: 100%;
    background-color: var(--color-dark);
    z-index: var(--z-navbar);
  }

  .nav-list {
    list-style: none;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding-top: var(--spacing-sm);
    padding-bottom: var(--spacing-sm);
    padding-left: var(--spacing-sm);
    padding-right: 6rem;
    height: 100%;
  }

  .nav-list__item {
    margin: 0 var(--spacing-sm);
    text-align: center;
  }

  .nav-list__link {
    color: var(--color-text-on-dark);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-light);
    padding-bottom: 2px; /* room for the hover underline (effects.css) */
  }

  .nav-list__link:hover,
  .nav-list__link.is-active {
    color: var(--color-primary-on-dark);
  }

  /* Hamburger Menu */
  .menu-icon {
    display: none;
    flex-direction: column;
    cursor: pointer;
    width: 30px;
    background: none;
    border: none;
    padding: 0;
    z-index: var(--z-hamburger);
  }

  .menu-icon__line {
    height: 3px;
    background-color: var(--color-text-on-dark);
    margin: 5px 0;
    transition: var(--transition-slow);
  }

  @media (max-width: 767px) {
    .nav-list {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: var(--navbar-height);
      padding: 0;
      width: 100%;
      height: calc(100vh - var(--navbar-height));
      max-height: 600px;
      background-color: var(--color-dark);
      align-items: center;
      justify-content: flex-start;
      z-index: var(--z-menu);
      transform: translateY(-100%);
      opacity: 0;
      transition: transform var(--transition-slow), opacity var(--transition-slow);
    }

    .nav-list.show {
      transform: translateY(0);
      opacity: 0.9;
    }

    .nav-list__item {
      margin: 2% 0;
      font-size: var(--font-size-2xl);
    }

    .menu-icon {
      display: flex;
      position: fixed;
      top: 30px;
      right: 20px;
      cursor: pointer;
      flex-direction: column;
      width: 30px;
      z-index: var(--z-hamburger);
    }

    .menu-icon__line {
      width: 20px;
      background-color: var(--color-text-on-dark);
      height: 4px;
      border-radius: 3px;
      margin: 2px 0;
      transition: var(--transition-slower);
    }

    .menu-icon.active .menu-icon__line {
      background-color: var(--color-text-on-dark);
    }

    .menu-icon.active .menu-icon__line:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .menu-icon.active .menu-icon__line:nth-child(2) {
      opacity: 0;
    }

    .menu-icon.active .menu-icon__line:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }

  @media (max-width: 575px) {
    .nav-list__link {
      font-size: 16px;
    }
  }
</style>
