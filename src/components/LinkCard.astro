---
const { hobby } = Astro.props;
---

<a href={hobby.link} target="_blank" class="link-card">
  <div class="video-container">
    <img src={hobby.img} alt={hobby.alt} class="thumbnail" loading="lazy" />
  </div>
  <p><br />{hobby.text}</p>
</a>

<style>
  /* Hover tuning: --lift-*, --media-zoom-* tokens in styles/effects.css */
  .link-card {
    display: flex;
    flex: 1 1 calc(50% - var(--spacing-lg));
    min-width: 300px;
    min-height: 300px;
    background-color: var(--color-surface-alt);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-lg);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--lift-duration) var(--ease-out),
      box-shadow var(--lift-duration) var(--ease-out),
      background-color var(--transition-normal);
  }

  .link-card:hover,
  .link-card:focus-visible {
    transform: translateY(var(--lift-distance));
    box-shadow: var(--lift-shadow);
    background-color: var(--color-primary-soft);
  }

  /* Clipped frame so the zoomed thumbnail stays inside its rounded corners */
  .video-container {
    position: relative;
    width: 100%;
    max-width: 350px;
    overflow: hidden;
    border-radius: var(--border-radius-lg);
  }

  .thumbnail {
    width: 100%;
    transition: transform var(--media-zoom-duration) var(--ease-out);
  }

  .link-card:hover .thumbnail,
  .link-card:focus-visible .thumbnail {
    transform: scale(var(--media-zoom));
  }

  @media (min-width: 768px) {
    .link-card {
      flex: 1 1 calc(50% - var(--spacing-md));
    }
  }

  @media (max-width: 767px) {
    .link-card {
      width: 100%;
      min-width: 60%;
    }
  }
</style>
