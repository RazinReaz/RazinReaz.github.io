---
import { slidesData, isVideoSource, overlayTextFor } from "../data/slides.js";

export interface Props {
  /** Milliseconds between automatic slide advances. 0 disables autoplay. */
  autoplayInterval?: number;
  /** Show the dot indicators under the slider. */
  showDots?: boolean;
}

const { autoplayInterval = 15000, showDots = true } = Astro.props;
---

<div class="slideshow-container" data-autoplay-interval={autoplayInterval}>
  <div class="slider-wrapper">
    <button type="button" class="slider-arrow left" id="slider-left" aria-label="Scroll left">
      <i class="fas fa-chevron-left"></i>
    </button>
    <div class="slider" id="slider">
      {slidesData.map((slide) => (
        <div id={slide.id} class="slide">
          <a href={slide.link} target="_blank" class="slide-image-wrapper">
            {isVideoSource(slide.src) ? (
              <video src={slide.src} class="slide-image" muted loop playsinline preload="metadata" data-autoplay-visible></video>
            ) : (
              <img src={slide.src} alt={slide.alt} class="slide-image" loading="lazy">
            )}
            <div class="slide-overlay-text" set:html={overlayTextFor(slide)} />
          </a>
        </div>
      ))}
    </div>
    <button type="button" class="slider-arrow right" id="slider-right" aria-label="Scroll right">
      <i class="fas fa-chevron-right"></i>
    </button>
  </div>

  {showDots && (
    <div class="slider-dots" role="group" aria-label="Choose slide">
      {slidesData.map((slide, i) => (
        <button type="button" class="slider-dot" data-index={i} aria-label={`Go to slide ${i + 1}: ${slide.alt}`}></button>
      ))}
    </div>
  )}
</div>

<script>
  const container = document.querySelector<HTMLElement>(".slideshow-container");
  const slider = document.getElementById("slider");
  const leftArrow = document.getElementById("slider-left") as HTMLButtonElement | null;
  const rightArrow = document.getElementById("slider-right") as HTMLButtonElement | null;

  if (container && slider && leftArrow && rightArrow) {
    const AUTOPLAY_INTERVAL = Number(container.dataset.autoplayInterval) || 0;
    const EDGE_THRESHOLD = 10;
    const ACTIVE_DOT_CLASS = "is-active";

    const slides = [...slider.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...container.querySelectorAll<HTMLButtonElement>(".slider-dot")];
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const maxScroll = () => slider.scrollWidth - slider.clientWidth;
    const scrollBehavior = () => (reduceMotion.matches ? "auto" : "smooth");

    // Index of the slide the viewer is looking at (edges win so the first/last dot can be active)
    function currentIndex() {
      if (slider.scrollLeft <= EDGE_THRESHOLD) return 0;
      if (slider.scrollLeft >= maxScroll() - EDGE_THRESHOLD) return slides.length - 1;

      const center = slider.scrollLeft + slider.clientWidth / 2;
      let closest = 0;
      let closestDistance = Infinity;
      slides.forEach((slide, i) => {
        const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
        if (distance < closestDistance) {
          closest = i;
          closestDistance = distance;
        }
      });
      return closest;
    }

    // Scroll so slide `index` is centred; indices wrap around both ends
    function goTo(index: number) {
      const slide = slides[(index + slides.length) % slides.length];
      const target = slide.offsetLeft - (slider.clientWidth - slide.offsetWidth) / 2;
      slider.scrollTo({
        left: Math.min(Math.max(target, 0), maxScroll()),
        behavior: scrollBehavior(),
      });
    }

    function updateControls() {
      leftArrow.disabled = slider.scrollLeft <= EDGE_THRESHOLD;
      rightArrow.disabled = slider.scrollLeft >= maxScroll() - EDGE_THRESHOLD;

      const active = currentIndex();
      dots.forEach((dot, i) => {
        const isActive = i === active;
        dot.classList.toggle(ACTIVE_DOT_CLASS, isActive);
        dot.setAttribute("aria-current", String(isActive));
      });
    }

    let ticking = false;
    slider.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateControls();
        ticking = false;
      });
    }, { passive: true });
    window.addEventListener("resize", updateControls);
    updateControls();

    // Autoplay — advances one slide, loops back to the first after the last
    let autoplayTimer: ReturnType<typeof setInterval> | undefined;

    function stopAutoplay() {
      clearInterval(autoplayTimer);
      autoplayTimer = undefined;
    }

    function startAutoplay() {
      stopAutoplay();
      if (!AUTOPLAY_INTERVAL) return;
      autoplayTimer = setInterval(() => {
        if (slider.matches(":hover")) return;
        goTo(currentIndex() + 1);
      }, AUTOPLAY_INTERVAL);
    }

    // Manual navigation also restarts the autoplay timer
    function navigate(index: number) {
      goTo(index);
      startAutoplay();
    }

    leftArrow.addEventListener("click", () => navigate(currentIndex() - 1));
    rightArrow.addEventListener("click", () => navigate(currentIndex() + 1));
    dots.forEach((dot) => {
      dot.addEventListener("click", () => navigate(Number(dot.dataset.index)));
    });

    startAutoplay();
    slider.addEventListener("mouseenter", stopAutoplay);
    slider.addEventListener("mouseleave", startAutoplay);
    slider.addEventListener("pointerdown", startAutoplay);
    document.addEventListener("visibilitychange", () => {
      document.hidden ? stopAutoplay() : startAutoplay();
    });
  }
</script>

<style>
  .slideshow-container {
    /* Dot indicator tuning */
    --dot-size: 8px;
    --dot-active-width: 24px;
    --dot-gap: 0.5rem;
    --dot-color: var(--color-line);
    --dot-hover-color: var(--color-text-muted);
    --dot-active-color: var(--color-primary);

    /* Slide hover tuning (zoom/dim tokens live in styles/effects.css) */
    --slide-hover-lift: -0.5rem;
    --slide-hover-duration: 0.3s;

    padding: 1rem;
    margin-bottom: 1rem;
  }

  .slider-wrapper {
    position: relative;
    max-width: 100%;
    max-height: 30rem;
    width: 100%;
    height: auto;
    min-height: 300px;
    overflow: hidden;
    margin: 0 auto;
    display: flex;
    align-items: center;
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 4rem;
    height: 4rem;
    background: var(--color-dark);
    border: none;
    border-radius: 50%;
    color: var(--color-text-on-dark);
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
    opacity: 0.7;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slider-arrow:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.2);
  }

  .slider-arrow.left {
    left: 1rem;
  }

  .slider-arrow.right {
    right: 1rem;
  }

  .slider-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .slider-arrow:disabled:hover {
    transform: translateY(-50%);
  }

  .slider {
    position: relative; /* makes slide.offsetLeft relative to the slider */
    display: flex;
    max-width: 100%;
    max-height: 30rem;
    height: auto;
    min-height: 300px;
    width: 100%;
    justify-content: flex-start;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .slider {
      scroll-behavior: smooth;
    }
  }

  .slider::-webkit-scrollbar {
    display: none;
  }

  .slide {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 40%;
    scroll-snap-align: center;
    padding-left: 1rem;
    padding-right: 1rem;
    min-width: 0;
  }

  .slide-image-wrapper {
    position: relative;
    width: 100%;
    height: auto;
    min-height: 200px;
    max-width: 100%;
    max-height: 30rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1.5rem 3rem -0.75rem var(--color-shadow-strong);
    transition:
      transform var(--slide-hover-duration) var(--ease-out),
      box-shadow var(--slide-hover-duration) var(--ease-out);
    border-radius: 0.5rem;
    overflow: hidden; /* clips the zoomed media */
  }

  .slide-image-wrapper:hover,
  .slide-image-wrapper:focus-visible {
    transform: translateY(var(--slide-hover-lift));
    box-shadow: 0 2rem 4rem -1rem var(--color-primary);
  }

  .slide-image {
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 30rem;
    border-radius: 0.5rem;
    object-fit: contain;
    object-position: center;
    transition:
      transform var(--media-zoom-duration) var(--ease-out),
      filter var(--media-zoom-duration) var(--ease-out);
  }

  .slide-image-wrapper:hover .slide-image,
  .slide-image-wrapper:focus-visible .slide-image {
    filter: brightness(var(--media-dim));
    transform: scale(var(--media-zoom));
  }

  .slide-overlay-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--color-text-on-dark);
    font-size: 1.25rem;
    font-weight: 200;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    z-index: 2;
    text-shadow: 0 2px 4px var(--color-scrim);
  }

  .slide-image-wrapper:hover .slide-overlay-text,
  .slide-image-wrapper:focus-visible .slide-overlay-text {
    opacity: 1;
    transform: translate(-50%, -50%) translateY(-0.5rem);
  }

  .slide-overlay-text :global(b) {
    font-weight: 700;
  }

  /* Dot indicators */
  .slider-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--dot-gap);
    margin-top: var(--spacing-sm);
  }

  .slider-dot {
    width: var(--dot-size);
    height: var(--dot-size);
    padding: 0;
    border: none;
    border-radius: calc(var(--dot-size) / 2);
    background-color: var(--dot-color);
    cursor: pointer;
    transition:
      width var(--slide-hover-duration) var(--ease-out),
      background-color var(--slide-hover-duration) var(--ease-out);
  }

  .slider-dot:hover {
    background-color: var(--dot-hover-color);
  }

  .slider-dot.is-active {
    width: var(--dot-active-width);
    background-color: var(--dot-active-color);
  }

  @media (max-width: 768px) {
    .slide {
      flex: 0 0 90%;
    }

    .slider-arrow {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.2rem;
    }
  }

  @media (max-width: 576px) {
    .slide {
      flex: 0 0 100%;
      padding: 0.25rem;
    }

    .slider-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slideshow-container {
      --slide-hover-duration: 0.01ms;
    }
  }
</style>
