---
const { achievement } = Astro.props;
---

<div class="card">
  <div class="card__image">
    <img src={achievement.imageSrc} alt={achievement.imageAlt} class="achievement-media" loading="lazy">
  </div>
  <div class="card__content">
    <h3 class="card__title">{achievement.title}</h3>
    <h4 class="card__subtitle">{achievement.place}</h4>
    <p class="card__text" set:html={achievement.description}></p>
  </div>
</div>

<style>
  .card {
    display: flex;
    background-color: var(--color-surface-alt);
    padding: var(--spacing-sm);
    border-radius: var(--border-radius-xl);
    margin: 0 auto var(--spacing-md);
    box-shadow: var(--shadow-sm);
    gap: var(--spacing-lg);
    align-items: center;
    width: 95%;
    max-width: 1200px;
  }

  .card__image {
    flex: 0 0 100%;
    min-width: 0;
    max-width: 300px;
    max-height: 300px;
    min-height: 200px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--border-radius-xl);
  }

  .achievement-media {
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .card__content {
    flex: 1;
    min-width: 0;
    margin-left: var(--spacing-sm);
  }

  .card__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-xs);
  }

  .card__subtitle {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xs);
  }

  .card__text {
    width: 90%;
    max-width: 100%;
    font-size: var(--font-size-sm);
    text-align: left;
  }

  @media (min-width: 768px) {
    .card {
      gap: var(--spacing-md);
    }
  }

  @media (max-width: 767px) {
    .card {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .card__image {
      max-width: 100%;
    }
  }

  @media (max-width: 575px) {
    .card__title {
      font-size: var(--font-size-lg);
    }

    .card__text {
      font-size: var(--font-size-xs);
      text-align: left;
    }
  }
</style>
